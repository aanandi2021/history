{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset.schema.json",
  "title": "World Viewer dataset",
  "type": "object",
  "required": ["id", "title", "range", "lanes", "events", "leaders", "books", "chapters", "colours", "mapNote"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "range": { "type": "array", "items": { "$ref": "#/$defs/date" }, "minItems": 2, "maxItems": 2 },
    "note": { "type": "string" },
    "precision": { "enum": ["year"] },
    "mapNote": { "type": "string" },
    "lanes": { "type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "label"],
      "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "pinned": { "type": "boolean" }, "fiction": { "type": "boolean" } } } },
    "events": { "type": "array", "items": {
      "type": "object", "required": ["lane", "date", "title"],
      "properties": {
        "id": { "type": "string" }, "lane": { "type": "string" },
        "date": { "$ref": "#/$defs/date" }, "end": { "$ref": "#/$defs/date" },
        "title": { "type": "string" }, "text": { "type": "string" },
        "at": { "$ref": "#/$defs/lonlat" },
        "section": { "type": "string" }, "wiki": { "type": "string" }, "approx": { "type": "boolean" },
        "fic": { "$ref": "#/$defs/fic" }, "work": { "type": "string" } } } },
    "leaders": { "type": "array", "items": {
      "type": "object", "required": ["name", "country", "side"],
      "properties": {
        "name": { "type": "string" }, "country": { "type": "string" }, "side": { "type": "string" },
        "born": { "$ref": "#/$defs/date" }, "died": { "$ref": "#/$defs/date" }, "lifeUnknown": { "type": "boolean" },
        "start": { "$ref": "#/$defs/date" }, "end": { "$ref": "#/$defs/date" },
        "terms": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/date" }, "minItems": 2, "maxItems": 2 } },
        "section": { "type": "string" }, "wiki": { "type": "string" }, "fic": { "$ref": "#/$defs/fic" } } } },
    "books": { "type": "array", "items": {
      "type": "object", "required": ["title", "author", "start", "end", "owned"],
      "properties": {
        "title": { "type": "string" }, "author": { "type": "string" },
        "start": { "$ref": "#/$defs/date" }, "end": { "$ref": "#/$defs/date" },
        "owned": { "type": "boolean" }, "calibreId": { "type": "integer" },
        "section": { "type": "string" }, "canadian": { "type": "boolean" }, "fiction": { "type": "boolean" },
        "amits": { "type": "boolean" }, "note": { "type": "string" }, "heading": { "type": "string" } } } },
    "chapters": { "type": "array", "items": {
      "type": "object", "required": ["title", "start", "end", "bbox"],
      "properties": {
        "title": { "type": "string" }, "start": { "$ref": "#/$defs/date" }, "end": { "$ref": "#/$defs/date" },
        "bbox": { "type": "array", "items": { "$ref": "#/$defs/lonlat" }, "minItems": 2, "maxItems": 2 },
        "text": { "type": "string" }, "section": { "type": "string" }, "wiki": { "type": "string" }, "fic": { "$ref": "#/$defs/fic" },
        "id": { "type": "string" },
        "plate": { "type": "string", "description": "id of the atlas plate that maps this chapter" },
        "parent": { "type": "string", "description": "id of the chapter this one sits inside (e.g. ch-muscovy). Its dates must fall within the parent's." } } } },
    "plates": { "type": "array", "items": {
      "type": "object", "required": ["id", "title", "start", "end"],
      "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "start": { "$ref": "#/$defs/date" }, "end": { "$ref": "#/$defs/date" } } } },
    "mapStates": { "type": "array", "items": {
      "type": "object", "required": ["date", "label", "status"],
      "properties": { "date": { "$ref": "#/$defs/date" }, "label": { "type": "string" },
        "status": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "integer" } } } } } },
    "colours": { "type": "object", "required": ["lanes", "sides"] },
    "changelog": { "type": "array" }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^(-\\d{1,4}|\\d{4})(-\\d{2}(-\\d{2})?)?$" },
    "lonlat": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "fic": { "oneOf": [
      { "type": "string", "description": "heading in the work's main note" },
      { "type": "object", "required": ["note"], "properties": { "note": { "type": "string" }, "heading": { "type": "string" } } } ] }
  }
}
