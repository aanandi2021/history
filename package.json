{
  "name": "amits-world-history",
  "version": "1.3.0-dev",
  "private": true,
  "description": "Amit's Notes of the History of the World: a static timeline and map viewer.",
  "scripts": {
    "stamp": "node scripts/stamp_version.mjs",
    "serve": "python -m http.server 8766 --bind 127.0.0.1",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:data": "node --test tests/data.test.mjs tests/model.test.mjs",
    "test:e2e": "node --test tests/e2e.test.mjs tests/walkthrough.test.mjs",
    "test:atlas": "node --test tests/atlas.test.mjs",
    "plate": "node scripts/plate_check.mjs",
    "build:walkthrough": "python scripts/build_walkthrough.py",
    "build:notes": "python scripts/build_data.py"
  },
  "devDependencies": {
    "mapshaper": "^0.7.79",
    "marked": "^18.0.14",
    "puppeteer": "25.5.0",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "world-atlas": "^2.0.2"
  }
}
